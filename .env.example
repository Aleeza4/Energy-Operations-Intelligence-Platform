# ============================================================
# Energy Operations Intelligence Platform (EOIP)
# Environment Variable Template
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

EOIP_DATABASE_HOST=localhost
EOIP_DATABASE_PORT=5432
EOIP_DATABASE_NAME=eoip
EOIP_DATABASE_USER=postgres
EOIP_DATABASE_PASSWORD=replace_with_your_local_postgresql_password

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

EOIP_LOG_LEVEL=INFO

# Streamlit-to-API integration. Obtain a short-lived bearer token from the
# configured EOIP API; never commit a populated .env file.
EOIP_API_BASE_URL=http://127.0.0.1:8000/api/v1
EOIP_API_ACCESS_TOKEN=
EOIP_API_REQUEST_TIMEOUT_SECONDS=10
