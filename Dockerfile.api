# ============================================================
# EOIP FastAPI Container
# Energy Operations Intelligence Platform
# ============================================================

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

# ------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Python project metadata and source
# ------------------------------------------------------------
COPY pyproject.toml README.md ./
COPY src ./src

# Alembic files are required for container-side migrations.
COPY alembic.ini ./
COPY migrations ./migrations

# ------------------------------------------------------------
# Install EOIP package
# ------------------------------------------------------------
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install .

# ------------------------------------------------------------
# Runtime security
# ------------------------------------------------------------
RUN groupadd --system eoip \
    && useradd \
        --system \
        --gid eoip \
        --create-home \
        --home-dir /home/eoip \
        eoip \
    && chown -R eoip:eoip /app

USER eoip

# ------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------
EXPOSE 8000



HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=20s \
    --retries=3 \
    CMD curl --fail http://127.0.0.1:8000/api/v1/health || exit 1

CMD ["uvicorn", "eoip.api.app:app", "--host", "0.0.0.0", "--port", "8000"]