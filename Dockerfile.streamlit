# ============================================================
# EOIP Streamlit Container
# Energy Operations Intelligence Platform
# ============================================================

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

# ------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Python project metadata and source
# ------------------------------------------------------------
COPY pyproject.toml README.md ./
COPY src ./src

# ------------------------------------------------------------
# Install EOIP package
# ------------------------------------------------------------
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install .

# ------------------------------------------------------------
# Runtime security
# ------------------------------------------------------------
RUN groupadd --system eoip \
    && useradd \
        --system \
        --gid eoip \
        --create-home \
        --home-dir /home/eoip \
        eoip \
    && chown -R eoip:eoip /app

USER eoip

# ------------------------------------------------------------
# Streamlit runtime configuration
# ------------------------------------------------------------
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

EXPOSE 8501

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=20s \
    --retries=3 \
    CMD curl --fail http://127.0.0.1:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "src/eoip/app/main.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]